{
  "name": "@family/api",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm --filter @family/contracts build",
    "build": "tsc -p tsconfig.json",
    "db:migrate": "drizzle-kit migrate",
    "dev:seed": "node dist/dev/seed-cli.js",
    "pretest": "pnpm --filter @family/contracts build",
    "pretypecheck": "pnpm --filter @family/contracts build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@family/contracts": "workspace:*",
    "drizzle-orm": "0.45.2",
    "entities": "8.0.0",
    "fastify": "5.11.2",
    "parse5": "8.0.1",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0"
  }
}
